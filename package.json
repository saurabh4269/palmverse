{
  "name": "palmverse",
  "version": "0.1.0",
  "description": "Hast Rekha, the Indian tradition of reading the hand, drawn in light on your real palm in mixed reality. Hands-only WebXR for Meta Quest 3.",
  "private": true,
  "license": "MIT",
  "author": "Saurabh Gupta",
  "homepage": "https://github.com/saurabh4269/palmverse#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saurabh4269/palmverse.git"
  },
  "bugs": {
    "url": "https://github.com/saurabh4269/palmverse/issues"
  },
  "keywords": [
    "webxr",
    "meta-quest",
    "quest-3",
    "mixed-reality",
    "passthrough",
    "hand-tracking",
    "iwsdk",
    "threejs",
    "palmistry",
    "hast-rekha",
    "samudrika-shastra",
    "india",
    "culture"
  ],
  "type": "module",
  "scripts": {
    "dev": "iwsdk dev restart --open --foreground",
    "dev:runtime": "vite",
    "dev:down": "iwsdk dev down",
    "dev:status": "iwsdk dev status",
    "reference:status": "iwsdk reference status",
    "reference:warmup": "iwsdk reference warmup",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "preview": "vite preview",
    "setup": "iwsdk adapter sync && iwsdk reference warmup",
    "test": "node tools/run-unit.mjs",
    "test:xr": "python3 tools/e2e.py"
  },
  "dependencies": {
    "@fontsource/mukta": "^5.3.0",
    "@fontsource/rozha-one": "^5.3.0",
    "@fontsource/tiro-devanagari-hindi": "^5.3.0",
    "@iwsdk/core": "1.1.0",
    "@pmndrs/uikit": "^1.0.74",
    "@pmndrs/uikit-horizon": "^1.0.74",
    "@pmndrs/uikit-lucide": "^1.0.74",
    "three": "npm:super-three@0.185.0"
  },
  "devDependencies": {
    "@iwsdk/cli": "1.1.0",
    "@iwsdk/reference": "1.1.0",
    "@iwsdk/vite-plugin-dev": "1.1.0",
    "@meta-quest/metavr": "^1.8.1",
    "@types/three": "^0.185.0",
    "typescript": "^5.5.0",
    "vite": "^7.1.4"
  },
  "overrides": {
    "sharp": "0.35.4",
    "three": "npm:super-three@0.185.0"
  },
  "engines": {
    "node": ">=20.19.0 <21.0.0-0 || >=22.12.0 <23.0.0-0 || >=24.0.0"
  }
}
